{
    "name": "f5-anything",
    "displayName": "F5 Anything (Zero-Config Code Runner)",
    "description": "Press F5 to build & run any programming language instantly. Supports Exclude / Include mode per folder.",
    "version": "0.2.1",
    "publisher": "loerei",
    "main": "./extension.js",
    "activationEvents": [
        "onCommand:f5-anything.excludeCurrentFolder",
        "onCommand:f5-anything.includeCurrentFolder",
        "onCommand:f5-anything.toggleMode",
        "onCommand:f5-anything.runSmart"
    ],
    "engines": {
        "vscode": "^1.80.0"
    },
    "categories": [
        "Keymaps",
        "Other"
    ],
    "keywords": [
        "f5",
        "code runner",
        "run",
        "zero-config",
        "exclude mode"
    ],
    "icon": "icon.png",
    "galleryBanner": {
        "color": "#1a1a1a",
        "theme": "dark"
    },
    "homepage": "https://github.com/loerei/f5-anything#readme",
    "repository": {
        "type": "git",
        "url": "https://github.com/loerei/f5-anything.git"
    },
    "bugs": {
        "url": "https://github.com/loerei/f5-anything/issues"
    },
    "extensionDependencies": [
        "formulahendry.code-runner"
    ],
    "contributes": {
        "commands": [
            {
                "command": "f5-anything.excludeCurrentFolder",
                "title": "F5 Anything: Exclude Current Folder"
            },
            {
                "command": "f5-anything.includeCurrentFolder",
                "title": "F5 Anything: Include Current Folder"
            },
            {
                "command": "f5-anything.toggleMode",
                "title": "F5 Anything: Toggle Mode (Exclude / Include)"
            }
        ],
        "keybindings": [
            {
                "key": "f5",
                "command": "f5-anything.runSmart",
                "when": "editorTextFocus"
            },
            {
                "key": "shift+f5",
                "command": "code-runner.stop",
                "when": "editorTextFocus"
            }
        ],
        "configuration": {
            "title": "F5 Anything",
            "properties": {
                "f5-anything.mode": {
                    "type": "string",
                    "enum": [
                        "exclude",
                        "include"
                    ],
                    "default": "exclude",
                    "description": "Select mode: 'exclude' runs on all folders except listed ones; 'include' runs ONLY on listed folders."
                },
                "f5-anything.excludedFolders": {
                    "type": "array",
                    "items": {
                        "type": "string"
                    },
                    "default": [],
                    "description": "List of folder paths to exclude from F5 execution."
                },
                "f5-anything.includedFolders": {
                    "type": "array",
                    "items": {
                        "type": "string"
                    },
                    "default": [],
                    "description": "List of folder paths to include for F5 execution."
                }
            }
        }
    }
}
